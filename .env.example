# LIKH AI - Environment Variables Template
# Copy this file to .env and fill in your values.
# DO NOT COMMIT YOUR REAL .env FILE WITH API KEYS!

# Backend Base URL (for Flutter app or API clients)
# Local: http://127.0.0.1:8000
# Android Emulator: http://10.0.2.2:8000
# Physical Device: http://<YOUR_LOCAL_IP>:8000
BACKEND_URL=http://127.0.0.1:8000

# Optional: Google Gemini API Key for enhanced AI text cleanup & grammar post-processing
GEMINI_API_KEY=

# Optional: Local Ollama LLM configuration (fallback when Gemini is not configured)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
